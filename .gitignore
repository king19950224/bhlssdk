# .NET
bin/
obj/
*.user
*.suo
*.userprefs
.vs/
.vscode/
*.dll
*.exe
*.pdb
*.vsix
project.lock.json

# Rider / VS Code
.idea/
*.swp

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Logs
*.log
logs/
nlog.log
serilog-*

# Local secrets
appsettings.Development.json
appsettings.Local.json
appsettings.json.bak*
secrets.json
# 旧的说明配置，程序已不再读取。留在忽略名单里，避免现场残留的密钥被提交
ai.json
*.pfx
*.pem
license.json

# Build artifacts
publish/
out/
artifacts/

# Test results
TestResults/
coverage.xml
*.coverage
*.coveragexml

# Runtime data（波形、大屏 SQLite 历史等，不进 git）
data/

# 非交付范围的资料（厂家原始包、软著、会议材料等）
# 用 资料/* 而不是 资料/：整个目录被排除时 git 不会下探，!负向规则走不到。
资料/*
!资料/工程文档/

# 厂家上位机软件（安装包与运行时）
厂家软件/

# 本地草稿与办公产物
tmp_*.txt
tmp/
output/

# tools/ 下一次性文档处理残留（截图、PPT 脚本、汇报 dump），不入库
tools/*.png
tools/*.jpg
tools/*.pdf
tools/*.txt
tools/*.docx
tools/cur_imgs/
tools/pptx_*.py
tools/pdf_pages.py

# 一键发布产物（publish.ps1）
dist/

# 临时编译目录
.tmp-build/

# tools/ 下的缓存和 dump 文本
tools/__pycache__/
tools/dump_*.txt
tools/enh_log.txt

# 现场数据表
/连续记录-*.xlsx
