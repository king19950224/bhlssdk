<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <Title>iFast Device SDK</Title>
        <Copyright>Beijing iFast Technology Co., Ltd.</Copyright>
        <Authors>iFast</Authors>
        <PackageVersion>1.6.0</PackageVersion>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MathNet.Filtering" Version="0.7.0" />
      <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
      <PackageReference Include="MathNet.Symbolics" Version="0.24.0" />
      <PackageReference Include="FParsec" Version="1.1.1" />
      <PackageReference Include="NLog" Version="5.3.4" />
      <PackageReference Include="System.IO.Pipelines" Version="6.0.3" Condition="'$(TargetFramework)' == 'net6.0'" />
      <PackageReference Include="System.IO.Pipelines" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
      <PackageReference Include="System.IO.Ports" Version="6.0.0" Condition="'$(TargetFramework)' == 'net6.0'" />
      <PackageReference Include="System.IO.Ports" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    </ItemGroup>

</Project>
