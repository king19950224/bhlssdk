{
  "reconnectSeconds": 10,
  "statusSeconds": 30,
  // 同通道两次打印的最小间隔（秒）。状态码变了立刻打
  "printIntervalSeconds": 1,
  // 空则不记
  "rawDir": "raw",
  // 原始报文要开 SDK 开发者模式才解得出
  "rawHex": true,
  // 每帧打印报文前多少字节。0 不打，9999 整条
  "hexPreviewBytes": 32,
  // 空则不存，启动也不回灌
  "zeroFile": "zero.json",

  "devices": [
    {
      "name": "1号监测点",
      "endpoint": "192.168.0.7:23",
      "address": 1,
      "channelCount": 5,

      // true：下发下面的参数并开轮询，会盖掉设备里现有参数
      "applyConfigOnConnect": false,

      "connectTimeout": 20,
      // 0 Lora Mesh，1 直连
      "transferMode": 1,
      "frequency": 10,
      "sampleDepth": 4,
      // 0 连续轮询
      "dailyCount": 0,
      "singleCount": 30,

      // 2026-08-11 从设备读回的。改之前按 P 对一下
      "channel": {
        "probeFreq": 2.0,
        // ns。不填则用 lengthMm + soundSpeed 换算
        "echoWin": 27000,
        "echoWidth": 40,
        "gain": 6,
        // 0 自动法 / 1 动态特征法 / 2 阈值法。各通道用同一档
        "measMode": 0,
        // 0：按峰值 60%
        "threshold": 0,
        // 0 不温补 / 1 材料系数 / 2 自定义系数
        "tcMode": 1,
        "refTemp": 22.22,
        "tempTauSeconds": 180
      },

      // 只写和上面不同的项。测量方法不要在这里改
      "channelOverrides": [
        { "channel": 3, "gain": 5 },
        { "channel": 4, "echoWin": 80000, "gain": 10 },
        { "channel": 5, "echoWin": 26000 }
      ]
    }
  ]
}
