{
  // 断线后隔多久重连
  "reconnectSeconds": 10,
  // 每隔多久打印一次已连接设备概览
  "statusSeconds": 30,
  // 同一个通道两次打印的最小间隔，防止刷屏；状态码变化时立即打印
  "printIntervalSeconds": 1,
  // 原始数据落盘目录（每帧的波形点和原始报文），留空不记录
  "rawDir": "raw",
  // 原始报文要打开 SDK 开发者模式才解得出来
  "rawHex": true,
  // 控制台每帧显示原始报文的前多少字节，0 不显示，写 9999 就是整条 hexdump
  "hexPreviewBytes": 32,
  // 置零结果存这里，启动时自动回灌；留空就不存也不回灌
  "zeroFile": "zero.json",

  "devices": [
    {
      "name": "1号监测点",
      // 设备的 IP:端口
      "endpoint": "192.168.0.7:23",
      "address": 1,
      // 单终端的超声通道数
      "channelCount": 5,

      // false = 只收数据，不动设备
      // true  = 下发下面的参数并启动多通道轮询，会覆盖设备里现有的参数
      "applyConfigOnConnect": false,

      "connectTimeout": 20,
      // 0 = Lora Mesh，1 = 直连
      "transferMode": 1,
      // 设备测量频率 Hz
      "frequency": 10,
      "sampleDepth": 4,
      // 0 = 连续轮询
      "dailyCount": 0,
      // 每轮每通道采集次数
      "singleCount": 30,

      // 所有通道的公共参数，下面这些是 2026-08-11 从设备读回来的实际值，
      // 改错会让回波跑出窗口，动之前先按 P 读一遍设备现值
      "channel": {
        "probeFreq": 2.0,
        // 直接给回波窗口 ns；也可以改成写 lengthMm + soundSpeed 让程序换算
        "echoWin": 27000,
        "echoWidth": 40,
        "gain": 6,
        // 0 自动法 / 1 动态特征法 / 2 阈值法
        // 全部通道统一用一种，混用会让各测点锁在不同相位上，趋势之间没法比
        "measMode": 0,
        // 0 表示不设固定阈值，按峰值的 60% 自动判定
        "threshold": 0,
        // 0 不温补 / 1 材料系数 / 2 自定义系数
        "tcMode": 1,
        "refTemp": 22.22,
        "tempTauSeconds": 180
      },

      // 和公共参数不一样的通道写在这里，没写的字段沿用上面
      // 只放硬件差异（窗口、增益），测量方法不要在这里覆盖
      "channelOverrides": [
        { "channel": 3, "gain": 5 },
        { "channel": 4, "echoWin": 80000, "gain": 10 },
        { "channel": 5, "echoWin": 26000 }
      ]
    }
  ]
}
