<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>BoltPreload.Api</RootNamespace>
    <AssemblyName>BoltPreload.Api</AssemblyName>
    <UserSecretsId>boltpreload-api-dev</UserSecretsId>
    <!-- 运行时数据目录（波形/报告落地、日志）不要参与 SDK 默认 glob。
         否则 Microsoft.NET.Sdk.Web 会把 data/ 下成千上万个波形文件枚举成 Content/None item，
         导致 MSBuild/构建在“分配风暴”里卡死（实测 data/ 长到 5.9GB 时 dotnet build 卡 20+ 分钟）。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);data/**;logs/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- 注：不要装 Microsoft.AspNetCore.SignalR 包；
         SignalR 在 ASP.NET Core 8（Microsoft.NET.Sdk.Web）已内置，单独装会冲突 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Npgsql 显式引用，避免依赖 Infrastructure 的传递（Program.cs 直接用 NpgsqlDataSourceBuilder） -->
    <PackageReference Include="Npgsql" Version="8.0.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog.config 复制到输出目录，否则 NLog 找不到 -->
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 本地开发配置不能跟着交付包出去：里面有开发库口令、开发 JWT 密钥，还有
         AllowMissingLicenseInDevelopment=true。这文件一旦落到现场机器上，
         把 ASPNETCORE_ENVIRONMENT 改成 Development 就能绕开授权、顺带把仿真模式也放行。
         只在 publish 时排除，本地 dotnet run 照常加载。 -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- 集成测试直调 internal（如 SignalHealthService.CheckAsync 单轮检查） -->
    <InternalsVisibleTo Include="BoltPreload.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoltPreload.Domain\BoltPreload.Domain.csproj" />
    <ProjectReference Include="..\BoltPreload.Algorithms\BoltPreload.Algorithms.csproj" />
    <ProjectReference Include="..\BoltPreload.Application\BoltPreload.Application.csproj" />
    <ProjectReference Include="..\BoltPreload.Infrastructure\BoltPreload.Infrastructure.csproj" />
    <ProjectReference Include="..\BoltPreload.Calibration\BoltPreload.Calibration.csproj" />
    <ProjectReference Include="..\BoltPreload.Fx\BoltPreload.Fx.csproj" />
  </ItemGroup>

  <!-- 发布时自动携带前端构建产物 web/dist → wwwroot。
       此前靠人工拷贝，漏拷则客户现场打开是空白页；改为 publish 硬校验：
       dist 缺失直接编译期报错，提示先 npm run build。仅影响 dotnet publish，不影响日常 build/run。 -->
  <Target Name="CopyWebDistOnPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <WebDistFiles Include="$(MSBuildProjectDirectory)\..\..\web\dist\**\*" />
    </ItemGroup>
    <Error Condition="'@(WebDistFiles)' == ''"
           Text="web/dist 为空：请先在 web/ 目录执行 npm run build，再 dotnet publish（前端产物需打进 wwwroot）。" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(WebDistFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
