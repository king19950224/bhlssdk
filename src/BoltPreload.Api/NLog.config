<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

  <!-- Phase 2 真机调试：让 SDK 内部的协议帧（NLog Debug）也能看见 -->
  <!-- 仅 BoltPreload.Fx 项目下的 SDK 用 NLog，业务层用 Serilog -->

  <targets>
    <target xsi:type="Console"
            name="console"
            layout="${time} [NLog/${level:uppercase=true}] ${logger}: ${message} ${exception:format=tostring}"
            useDefaultRowHighlightingRules="true" />

    <target xsi:type="File"
            name="sdkfile"
            fileName="logs/sdk-${shortdate}.log"
            layout="${longdate} [${level:uppercase=true}] ${logger}: ${message} ${exception:format=tostring}"
            archiveAboveSize="10485760"
            maxArchiveFiles="10" />
  </targets>

  <rules>
    <!-- SDK 的 TcpSession 用 logger 名 "TcpSession"（厂家代码内部就这样）。
         minlevel=Info：默认不输出每帧 "DE DE DE DE …" 的 Debug 协议日志（真机常态每秒数十帧会刷屏、淹没业务日志）；
         需要抓帧调试时临时改回 Debug —— 本文件 autoReload=true，改完即生效，无需重启。 -->
    <logger name="TcpSession" minlevel="Info" writeTo="console,sdkfile" />
    <!-- 其他 NLog 日志 -->
    <logger name="*" minlevel="Info" writeTo="console,sdkfile" />
  </rules>

</nlog>
