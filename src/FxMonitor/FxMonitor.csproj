<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FxMonitor</AssemblyName>
    <AssemblyTitle>螺栓预紧力监视器</AssemblyTitle>
    <Product>螺栓预紧力监视器</Product>
    <Company>青岛百恒新能源技术有限公司</Company>
    <Copyright>Copyright © 2026 青岛百恒新能源技术有限公司</Copyright>
    <!-- 1.6：和大屏共用 farm.json/.ucf（按 IP 选设备接线、按法兰标定与额定）。窗口标题带版本号，现场一眼分清新旧 exe -->
    <Version>1.6.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FxDevice\FxDevice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 和大屏用同一份现场配置与标定文件：直接链接大屏项目里的 farm.json 与 .ucf 输出到 exe 旁，
         两边永远是同一份，同一颗螺栓两边一个数 -->
    <None Include="..\BoltPreload.Monitor\wwwroot\farm.json" Link="farm.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BoltPreload.Monitor\*.ucf" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
