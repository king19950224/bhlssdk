<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BoltPreload.Fx</RootNamespace>
    <AssemblyName>BoltPreload.Fx</AssemblyName>
    <!-- 厂家 SDK 内部用了 unsafe（WaveletTransform.FastForward1d 等） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="NLog" Version="6.1.3" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="MathNet.Filtering" Version="0.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoltPreload.Domain\BoltPreload.Domain.csproj" />
    <!-- 厂家 C# SDK 1.4 源码：以源码方式编入（避免 dll 升级问题） -->
    <ProjectReference Include="..\..\external\FxSDK\FxSDK.csproj" />
  </ItemGroup>

</Project>
