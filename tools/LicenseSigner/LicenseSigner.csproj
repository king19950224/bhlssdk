<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LicenseSigner</RootNamespace>
    <AssemblyName>LicenseSigner</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 关键：复用验签端的 LocalFileLicenseService.BuildSignaturePayload 与 LicenseDocument。
         签发工具若自己另写一份拼接逻辑，任何一处差异（字段顺序、日期格式、Modules 分隔符）
         都会导致"签出来的 license 现场验不过"，而且报错只会说"RSA 验签失败"，极难定位。
         直接引用同一份实现，使两端在编译期就不可能漂移。 -->
    <ProjectReference Include="..\..\src\BoltPreload.Infrastructure\BoltPreload.Infrastructure.csproj" />
  </ItemGroup>

</Project>
