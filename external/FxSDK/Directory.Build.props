<Project>

  <!--
    厂家 SDK 局部覆盖根级 Directory.Build.props 的严格设置：
    - 不把警告当错误（SDK 是闭源，我们不应该改 SDK 代码去消警告）
    - 不强制 .NET 分析器
    - 保持 SDK 原状，便于将来升级版本
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CA1822</NoWarn>
  </PropertyGroup>

  <!--
    含高危 CVE 的传递依赖提升（与根 Directory.Build.props 里的同一组，版本必须一起改）。
    本文件的存在会让 MSBuild 停止向上查找，根级 Directory.Build.props 的 PackageReference
    到不了 FxSDK 项目 —— 结果是 NuGet 漏洞扫描（dotnet list package 的 vulnerable 开关）
    始终把 FxSDK 报成 2 个 High（MathNet.Symbolics→FParsec 传递引入 4.3.0），客户安全扫描时会看到。
    这里不 Import 父级：父级还带 Company/Product/Version，会把我们的元数据盖到厂商 DLL 上。
    net8 下两者均为 facade 包（运行时用内置实现、也不会随发布产出），提升仅消除审计告警，无行为影响。
  -->
  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>
