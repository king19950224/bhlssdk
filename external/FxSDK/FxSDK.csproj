<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- 厂家原版是 TargetFrameworks=net6.0;net8.0 多目标。net6 已 EOL，全项目统一 net8，
             且本目录的 Directory.Build.props 截断了根级继承，根 props 的单数 TargetFramework 到不了这里，
             必须在本文件里改单数（与 1.4 时的处理一致，见 README.md） -->
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <Title>iFast Device SDK</Title>
        <Copyright>Beijing iFast Technology Co., Ltd.</Copyright>
        <Authors>iFast</Authors>
        <PackageVersion>1.6.0</PackageVersion>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MathNet.Filtering" Version="0.7.0" />
      <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
      <PackageReference Include="MathNet.Symbolics" Version="0.24.0" />
      <PackageReference Include="FParsec" Version="1.1.1" />
      <!-- 厂家 1.6 原版是 NLog 5.3.4 / System.IO.Ports 8.0.0。这里升到与 BoltPreload.Fx、DeviceSmokeTest
           一致的版本，避免把 2026-07 依赖统一时消掉的版本分叉带回来（sdk-changelog.md 有记录） -->
      <PackageReference Include="NLog" Version="6.1.3" />
      <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
      <PackageReference Include="System.IO.Ports" Version="10.0.9" />
    </ItemGroup>

</Project>
