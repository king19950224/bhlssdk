<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;CA1822;NU1903</WarningsNotAsErrors>
    <!-- 现场软件以中文日志/注释为主，不强制 XML 文档与本地化资源。
         分析器锁 net8：新 SDK 升默认严重度时，同一份代码不应在开发机编不过、CI 能过。 -->
    <NoWarn>$(NoWarn);CS1591;CA1031;CA1062;CA1303;CA1305;CA1707;CA1716;CA1848;CA2007;CA2254;CA1859</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>8.0</AnalysisLevel>

    <!-- macOS 拷到 Windows 会留下 AppleDouble 的 ._*.cs，MSBuild 会当源码编并报 CS2015。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/._*</DefaultItemExcludes>

    <Company>青岛百恒新能源技术有限公司</Company>
    <Product>螺栓预紧力超声测量</Product>
    <Copyright>Copyright © 2026 青岛百恒新能源技术有限公司</Copyright>
  </PropertyGroup>

  <!-- FxSDK→MathNet.Symbolics→FParsec 可能带上含 CVE 的 4.3.0 facade 包；
       提升不沿 ProjectReference 传播。厂家包在 bhls1.6/sdk16/FxSDK/Directory.Build.props
       截断本文件继承，那边另有一份同样的提升。 -->
  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>
