<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;CA1822;NU1903</WarningsNotAsErrors>
    <!-- 豁免几条对 Phase 1 不必要的 CA 规则（详见每条注释）：
         CS1591 缺 XML 注释
         CA1031 catch (Exception) 过宽（IngestionService 等故意这么写避免单点失败）
         CA1062 公共方法参数 null 检查（Phase 1 不强求）
         CA1303 字符串硬编码本地化（中文日志故意硬编码）
         CA1707 命名规范禁下划线（DTO 字段保留下划线表意）
         CA1716 标识符不要跟保留字冲突
         CA1848 必须用 LoggerMessage 委托（Phase 1 直接调 LogXxx，Phase 2 优化）
         CA2007 await 必须 ConfigureAwait(false)（ASP.NET Core 不需要，反而有害）
         CA2254 日志消息必须是常量模板 -->
    <NoWarn>$(NoWarn);CS1591;CA1031;CA1062;CA1303;CA1305;CA1707;CA1716;CA1848;CA2007;CA2254</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 商用关键基础设施监测系统：编译期更严格 -->
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Company>BoltPreload</Company>
    <Product>BoltPreload — 螺栓预紧力在线监测系统</Product>
    <Copyright>(c) BoltPreload Team</Copyright>
    <Version>0.1.0-alpha</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 全局禁用一些过于啰嗦的分析器警告（保留真正有意义的） -->
  </ItemGroup>

</Project>
